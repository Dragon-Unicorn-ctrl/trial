PORT=3000
JWT_SECRET=change-this-to-a-long-production-secret

# Optional Google Maps integrations.
# GOOGLE_MAPS_API_KEY is used by the backend for Distance Matrix route estimates.
# GOOGLE_MAPS_JS_API_KEY is used by the browser for Google map rendering.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_JS_API_KEY=

# Set to true only if you have a valid Google Maps JavaScript API key.
FORCE_GOOGLE_MAPS=false
